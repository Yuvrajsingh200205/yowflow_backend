// ===========================================================================
// FILES — metadata only. Binaries never enter PostgreSQL.
// ===========================================================================

model FileObject {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  uploadedById   String?         @map("uploaded_by_id") @db.Uuid
  entityType     String          @map("entity_type") @db.VarChar(48)
  entityId       String?         @map("entity_id") @db.Uuid
  projectId      String?         @map("project_id") @db.Uuid
  storageProvider StorageProvider @default(LOCAL) @map("storage_provider")
  bucket         String          @db.VarChar(120)
  objectKey      String          @map("object_key") @db.VarChar(512)
  originalName   String          @map("original_name") @db.VarChar(255)
  mimeType       String          @map("mime_type") @db.VarChar(160)
  sizeBytes      BigInt          @map("size_bytes")
  content        Bytes?          @map("content")
  isRegistered   Boolean         @default(true) @map("is_registered")
  checksum       String?         @db.VarChar(128)
  visibility     FileVisibility  @default(PRIVATE)
  metadata       Json?           @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?         @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  expenseAttachments ExpenseAttachment[]
  freelancerPortfolioItems FreelancerPortfolioItem[]

  clientPortalUserAvatars  ClientPortalUser[]       @relation("ClientPortalUserAvatar")
  galleryCovers            Gallery[]                @relation("GalleryCover")
  gallerySectionCovers     GallerySection[]         @relation("GallerySectionCover")
  gallerySubFolderCovers   GallerySubFolder[]       @relation("GallerySubFolderCover")
  galleryMedia             GalleryMedia[]           @relation("GalleryMediaFile")
  galleryDerivatives       GalleryMediaDerivative[] @relation("GalleryDerivativeFile")

  @@unique([bucket, objectKey])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([projectId])
  @@map("files")
}

// ===========================================================================
// NOTIFICATIONS
// ===========================================================================

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  type           NotificationType    @default(GENERAL)
  channel        NotificationChannel @default(IN_APP)
  title          String              @db.VarChar(200)
  message        String              @db.Text
  entityType     String?             @map("entity_type") @db.VarChar(48)
  entityId       String?             @map("entity_id") @db.Uuid
  isRead         Boolean             @default(false) @map("is_read")
  readAt         DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId, userId, isRead])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

// ===========================================================================
// AUDIT LOG — append-only. Secrets are stripped before write (see audit.service).
// ===========================================================================

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  actorId        String?     @map("actor_id") @db.Uuid
  action         AuditAction
  entityType     String      @map("entity_type") @db.VarChar(48)
  entityId       String?     @map("entity_id") @db.Uuid
  summary        String?     @db.VarChar(500)
  oldData        Json?       @map("old_data") @db.JsonB
  newData        Json?       @map("new_data") @db.JsonB
  ipAddress      String?     @map("ip_address") @db.Inet
  userAgent      String?     @map("user_agent") @db.VarChar(512)
  requestId      String?     @map("request_id") @db.VarChar(64)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ===========================================================================
// PLATFORM
// ===========================================================================

model SystemSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(80)
  value          Json     @db.JsonB
  description    String?  @db.VarChar(255)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}

/// Guarantees that a retried write (payment, invoice settlement, webhook) can
/// never create a second financial record. The stored response is replayed.
model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  key            String    @db.VarChar(120)
  endpoint       String    @db.VarChar(160)
  requestHash    String    @map("request_hash") @db.VarChar(64)
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body") @db.JsonB
  lockedAt       DateTime  @default(now()) @map("locked_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ===========================================================================
// SETTINGS WORKSPACE
//
// Purely additive. Everything the Settings screens own lives in these three
// tables; nothing here duplicates a field that already has an owner elsewhere.
//   * Studio identity (name, contact, timezone, currency) stays on
//     `Organization` — the single source of truth every other module reads.
//   * Employee identity (fullName, phone) stays on `User`.
//   * Module grants stay in `Role` / `RolePermission` / `UserRole` — approving
//     a request writes there, so the Roles & Permissions desk sees it too.
// ===========================================================================

enum ModuleAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Settings-only extras for a studio that have no column on `Organization`.
/// Kept in its own table so the shared `organizations` row is never reshaped.
model OrganizationSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  dateFormat     String?  @map("date_format") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// Per-employee Settings state: avatar URL plus the notification and security
/// toggle maps. The toggles are `jsonb` because the catalogue of switches is
/// presentation state that changes with the UI, not a relational fact.
model UserSetting {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  notifications Json     @default("{}") @map("notifications") @db.JsonB
  security      Json     @default("{}") @map("security") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// An employee's request for access to a module. Approving one grants the
/// module's permission keys through the existing RBAC tables; this row is only
/// the paper trail of who asked, who decided and why.
model ModuleAccessRequest {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  employeeId     String                    @map("employee_id") @db.Uuid
  moduleKey      String                    @map("module_key") @db.VarChar(48)
  reason         String                    @db.Text
  status         ModuleAccessRequestStatus @default(PENDING)
  reviewedById   String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  reviewReason   String?                   @map("review_reason") @db.Text
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     User         @relation("ModuleAccessRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ModuleAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([employeeId, status])
  @@index([reviewedById])
  @@map("module_access_requests")
}

// ===========================================================================
// CLIENT PORTAL & WEDDING GALLERIES
//
// The couple-facing side of a project. PostgreSQL holds only the structure and
// the decisions — every photograph and film lives with the storage provider and
// is reached through `FileObject` (§22), because a wedding delivery runs to tens
// of gigabytes and must never sit in a `bytea` column.
//
// Portal identities are deliberately separate from `User` (studio staff) and
// from `Freelancer`. A couple signing in must never traverse CRM authorisation.
// ===========================================================================

/// A couple's login for the portal. Scoped to one CRM client, so a repeat
/// client reaches every wedding they have booked with one account.
model ClientPortalUser {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  clientId            String                 @map("client_id") @db.Uuid
  email               String                 @db.VarChar(160)
  fullName            String                 @map("full_name") @db.VarChar(160)
  phone               String?                @db.VarChar(32)
  passwordHash        String?                @map("password_hash") @db.VarChar(255)
  avatarFileId        String?                @map("avatar_file_id") @db.Uuid
  status              ClientPortalUserStatus @default(INVITED)
  failedLoginAttempts Int                    @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?              @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?              @map("last_login_at") @db.Timestamptz(6)
  invitedAt           DateTime?              @map("invited_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?                @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  avatarFile   FileObject?  @relation("ClientPortalUserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  sessions      ClientPortalSession[]
  selections    GalleryMediaSelection[]
  comments      ClientPortalComment[]
  requests      ClientPortalRequest[]
  notifications ClientPortalNotification[]

  @@unique([organizationId, email])
  @@index([clientId, status])
  @@map("client_portal_users")
}

/// Refresh-token sessions for the portal, mirroring `FreelancerSession`. Only
/// the hash is stored, and revocation is explicit rather than by deletion.
model ClientPortalSession {
  id               String        @id @default(uuid()) @db.Uuid
  portalUserId     String        @map("portal_user_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(64)
  status           SessionStatus @default(ACTIVE)
  ipAddress        String?       @map("ip_address") @db.Inet
  userAgent        String?       @map("user_agent") @db.VarChar(512)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastUsedAt       DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokeReason     LogoutReason? @map("revoke_reason")

  portalUser ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId, status])
  @@index([expiresAt])
  @@map("client_portal_sessions")
}

/// One gallery per project — the couple's whole wedding collection.
model Gallery {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  projectId             String        @unique @map("project_id") @db.Uuid
  title                 String        @db.VarChar(200)
  welcomeMessage        String?       @map("welcome_message") @db.Text
  coverFileId           String?       @map("cover_file_id") @db.Uuid
  status                GalleryStatus @default(DRAFT)
  /// How many photographs the couple must choose for their album.
  albumSelectionTarget  Int           @default(60) @map("album_selection_target")
  expectedDeliveryDate  DateTime?     @map("expected_delivery_date") @db.Date
  publishedAt           DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedBy             String?       @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coverFile    FileObject?  @relation("GalleryCover", fields: [coverFileId], references: [id], onDelete: SetNull)

  sections   GallerySection[]
  subFolders GallerySubFolder[]
  media      GalleryMedia[]
  shareLinks GalleryShareLink[]
  comments   ClientPortalComment[]
  requests   ClientPortalRequest[]

  @@index([organizationId, status])
  @@map("galleries")
}

/// A client-facing folder for one ceremony. Linked to the CRM `Event` where one
/// exists, so the studio never maintains the wedding calendar twice.
model GallerySection {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  galleryId            String               @map("gallery_id") @db.Uuid
  eventId              String?              @map("event_id") @db.Uuid
  name                 String               @db.VarChar(160)
  description          String?              @db.Text
  sectionDate          DateTime?            @map("section_date") @db.Date
  venueName            String?              @map("venue_name") @db.VarChar(200)
  coverFileId          String?              @map("cover_file_id") @db.Uuid
  status               GallerySectionStatus @default(UPCOMING)
  leadPhotographer     String?              @map("lead_photographer") @db.VarChar(160)
  cinematographer      String?              @db.VarChar(160)
  /// Studio-controlled gates. Every one is enforced server side — a section the
  /// couple may not see is never serialised to them.
  isVisibleToClient    Boolean              @default(false) @map("is_visible_to_client")
  isDownloadAllowed    Boolean              @default(false) @map("is_download_allowed")
  isShareAllowed       Boolean              @default(false) @map("is_share_allowed")
  isFaceSearchAllowed  Boolean              @default(false) @map("is_face_search_allowed")
  hasWatermark         Boolean              @default(true) @map("has_watermark")
  expectedDeliveryDate DateTime?            @map("expected_delivery_date") @db.Date
  orderIndex           Int                  @default(0) @map("order_index")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamptz(6)
  deletedBy            String?              @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gallery      Gallery      @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  coverFile    FileObject?  @relation("GallerySectionCover", fields: [coverFileId], references: [id], onDelete: SetNull)

  subFolders GallerySubFolder[]
  media      GalleryMedia[]
  shareLinks GalleryShareLink[]

  @@index([galleryId, orderIndex])
  @@index([galleryId, isVisibleToClient])
  @@index([eventId])
  @@map("gallery_sections")
}

/// A category inside a ceremony — "Varmala & Pheras", "Candid Moments".
model GallerySubFolder {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  galleryId       String    @map("gallery_id") @db.Uuid
  sectionId       String    @map("section_id") @db.Uuid
  name            String    @db.VarChar(160)
  description     String?   @db.Text
  coverFileId     String?   @map("cover_file_id") @db.Uuid
  /// Accent token from the design system, not a raw colour.
  colorToken      String?   @map("color_token") @db.VarChar(32)
  isClientVisible Boolean   @default(true) @map("is_client_visible")
  orderIndex      Int       @default(0) @map("order_index")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?   @map("deleted_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gallery      Gallery        @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  section      GallerySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  coverFile    FileObject?    @relation("GallerySubFolderCover", fields: [coverFileId], references: [id], onDelete: SetNull)

  media GalleryMedia[]

  @@unique([sectionId, name])
  @@index([galleryId, orderIndex])
  @@map("gallery_sub_folders")
}

/// One photograph or film in a gallery. The bytes live in `FileObject`; this
/// row carries only what the portal needs to present and gate it.
model GalleryMedia {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  galleryId         String                   @map("gallery_id") @db.Uuid
  sectionId         String                   @map("section_id") @db.Uuid
  subFolderId       String?                  @map("sub_folder_id") @db.Uuid
  fileId            String                   @unique @map("file_id") @db.Uuid
  title             String                   @db.VarChar(255)
  mediaType         GalleryMediaType         @map("media_type")
  category          GalleryMediaCategory     @default(PHOTOS)
  width             Int?
  height            Int?
  orientation       GalleryMediaOrientation?
  /// Films only, in whole seconds.
  durationSeconds   Int?                     @map("duration_seconds")
  capturedAt        DateTime?                @map("captured_at") @db.Timestamptz(6)
  tags              String[]                 @default([])
  photographerCredit String?                 @map("photographer_credit") @db.VarChar(200)
  isClientVisible   Boolean                  @default(true) @map("is_client_visible")
  isDownloadAllowed Boolean                  @default(true) @map("is_download_allowed")
  orderIndex        Int                      @default(0) @map("order_index")
  viewCount         Int                      @default(0) @map("view_count")
  downloadCount     Int                      @default(0) @map("download_count")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(6)
  deletedBy         String?                  @map("deleted_by") @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gallery      Gallery           @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  section      GallerySection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subFolder    GallerySubFolder? @relation(fields: [subFolderId], references: [id], onDelete: SetNull)
  file         FileObject        @relation("GalleryMediaFile", fields: [fileId], references: [id], onDelete: Cascade)

  derivatives GalleryMediaDerivative[]
  selections  GalleryMediaSelection[]
  comments    ClientPortalComment[]
  requests    ClientPortalRequest[]
  shareLinks  GalleryShareLinkMedia[]

  @@index([galleryId, orderIndex])
  @@index([sectionId, isClientVisible])
  @@index([subFolderId])
  @@map("gallery_media")
}

/// Generated renditions — thumbnail, preview, watermarked, high-resolution.
/// Produced outside the request path; the original is never served directly.
model GalleryMediaDerivative {
  id        String                @id @default(uuid()) @db.Uuid
  mediaId   String                @map("media_id") @db.Uuid
  kind      GalleryDerivativeKind
  fileId    String                @map("file_id") @db.Uuid
  width     Int?
  height    Int?
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  media GalleryMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  file  FileObject   @relation("GalleryDerivativeFile", fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([mediaId, kind])
  @@index([fileId])
  @@map("gallery_media_derivatives")
}

/// A favourite or an album pick, recorded per portal user. Selections are rows
/// rather than flags on the media, because a couple and their families all
/// choose from the same gallery and must not overwrite one another.
model GalleryMediaSelection {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  mediaId        String               @map("media_id") @db.Uuid
  portalUserId   String               @map("portal_user_id") @db.Uuid
  kind           GallerySelectionKind
  note           String?              @db.Text
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media        GalleryMedia     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  portalUser   ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@unique([mediaId, portalUserId, kind])
  @@index([portalUserId, kind])
  @@map("gallery_media_selections")
}

/// A shareable link the couple hands to family. Passwords are hashed, never
/// stored in the clear, and revocation is explicit so a link can be killed.
model GalleryShareLink {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  galleryId        String             @map("gallery_id") @db.Uuid
  sectionId        String?            @map("section_id") @db.Uuid
  token            String             @unique @db.VarChar(64)
  title            String             @db.VarChar(200)
  accessType       GalleryShareAccess @default(VIEW_ONLY) @map("access_type")
  passwordHash     String?            @map("password_hash") @db.VarChar(255)
  watermarkEnabled Boolean            @default(true) @map("watermark_enabled")
  status           GalleryShareStatus @default(ACTIVE)
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz(6)
  viewsCount       Int                @default(0) @map("views_count")
  downloadsCount   Int                @default(0) @map("downloads_count")
  createdById      String?            @map("created_by_id") @db.Uuid
  createdByPortalUserId String?       @map("created_by_portal_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gallery      Gallery         @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  section      GallerySection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("GalleryShareCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  media GalleryShareLinkMedia[]

  @@index([galleryId, status])
  @@index([expiresAt])
  @@map("gallery_share_links")
}

/// The explicit photo set behind a SELECTED_ONLY share. Relational rather than
/// a JSON array of ids, so the set stays joinable and referentially sound (§5).
model GalleryShareLinkMedia {
  shareLinkId String @map("share_link_id") @db.Uuid
  mediaId     String @map("media_id") @db.Uuid

  shareLink GalleryShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  media     GalleryMedia     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([shareLinkId, mediaId])
  @@index([mediaId])
  @@map("gallery_share_link_media")
}

/// A note on a photograph. Written either by the couple or by the studio —
/// exactly one author, enforced by CHECK in the migration.
model ClientPortalComment {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  galleryId      String                  @map("gallery_id") @db.Uuid
  mediaId        String?                 @map("media_id") @db.Uuid
  portalUserId   String?                 @map("portal_user_id") @db.Uuid
  authorUserId   String?                 @map("author_user_id") @db.Uuid
  type           ClientPortalCommentType @default(GENERAL)
  body           String                  @db.Text
  isResolved     Boolean                 @default(false) @map("is_resolved")
  resolvedAt     DateTime?               @map("resolved_at") @db.Timestamptz(6)
  resolvedById   String?                 @map("resolved_by_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?               @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?                 @map("deleted_by") @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gallery      Gallery           @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  media        GalleryMedia?     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  portalUser   ClientPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  authorUser   User?             @relation("PortalCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?             @relation("PortalCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([galleryId, isResolved, createdAt])
  @@index([mediaId])
  @@map("client_portal_comments")
}

/// A change the couple has asked for — a retouch, a song swap, a reprint.
model ClientPortalRequest {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  galleryId      String                    @map("gallery_id") @db.Uuid
  projectId      String                    @map("project_id") @db.Uuid
  portalUserId   String                    @map("portal_user_id") @db.Uuid
  relatedMediaId String?                   @map("related_media_id") @db.Uuid
  type           ClientPortalRequestType   @default(OTHER)
  status         ClientPortalRequestStatus @default(OPEN)
  title          String                    @db.VarChar(200)
  description    String                    @db.Text
  adminResponse  String?                   @map("admin_response") @db.Text
  assignedToId   String?                   @map("assigned_to_id") @db.Uuid
  resolvedAt     DateTime?                 @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?                   @map("deleted_by") @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gallery      Gallery          @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portalUser   ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  relatedMedia GalleryMedia?    @relation(fields: [relatedMediaId], references: [id], onDelete: SetNull)
  assignedTo   User?            @relation("PortalRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([galleryId, status])
  @@index([assignedToId])
  @@map("client_portal_requests")
}

/// Portal-side timeline entries. Studio-authored, read by the couple.
model ClientPortalNotification {
  id           String                       @id @default(uuid()) @db.Uuid
  portalUserId String                       @map("portal_user_id") @db.Uuid
  projectId    String?                      @map("project_id") @db.Uuid
  type         ClientPortalNotificationType @default(GENERAL)
  title        String                       @db.VarChar(200)
  message      String                       @db.Text
  actionPath   String?                      @map("action_path") @db.VarChar(255)
  actionLabel  String?                      @map("action_label") @db.VarChar(80)
  isRead       Boolean                      @default(false) @map("is_read")
  readAt       DateTime?                    @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  portalUser ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([portalUserId, isRead, createdAt])
  @@map("client_portal_notifications")
}


/// One-time tokens for e-mail verification and password reset. Only the SHA-256
/// of the token is stored, so a database leak cannot be replayed.
model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

/// Messages submitted through the public marketing contact form.
model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(160)
  company   String?  @db.VarChar(160)
  phone     String?  @db.VarChar(32)
  message   String   @db.VarChar(4000)
  source    String?  @db.VarChar(60)
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("contact_messages")
}


/// Programmatic access. Only the SHA-256 of the key is stored; the plaintext is
/// shown once at creation. A key acts as the user who created it.
model ApiKey {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String      @db.VarChar(80)
  prefix         String      @db.VarChar(20)
  keyHash        String      @unique @map("key_hash") @db.VarChar(64)
  scope          ApiKeyScope @default(READ_ONLY)
  lastUsedAt     DateTime?   @map("last_used_at") @db.Timestamptz(6)
  expiresAt      DateTime?   @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}
