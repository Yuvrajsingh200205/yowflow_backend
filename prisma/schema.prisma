// ---------------------------------------------------------------------------
// Yowflow — PostgreSQL schema
//
// PostgreSQL is the single source of truth. There is no MySQL support and no
// dual-engine configuration anywhere in this service.
//
// Conventions enforced throughout:
//   * Primary/foreign keys .......... native `uuid` (@db.Uuid)
//   * Money ......................... `numeric(14,2)` (@db.Decimal(14, 2)) — never Float
//   * Timestamps .................... `timestamptz(6)` — timezone-aware everywhere
//   * Semi-structured payloads ...... `jsonb` (@db.JsonB) — only where relational
//                                     modelling would add no value
//   * Fields are camelCase in TypeScript and snake_case in PostgreSQL (@map)
//   * CHECK constraints and partial indexes live in the migration SQL, since
//     Prisma cannot express them — see prisma/migrations/*/migration.sql
// ---------------------------------------------------------------------------

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  // Loads `include`/nested `select` with LATERAL JOINs instead of one extra
  // query per relation, which is what made list endpoints round-trip bound.
  previewFeatures = ["relationJoins"]
}

