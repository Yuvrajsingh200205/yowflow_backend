// ===========================================================================
// TENANCY — Organization > Branch > Users > CRM data
// ===========================================================================

model Organization {
  apiKeys      ApiKey[]
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(160)
  slug         String             @unique @db.VarChar(80)
  legalName    String?            @map("legal_name") @db.VarChar(200)
  email        String?            @db.VarChar(160)
  phone        String?            @db.VarChar(32)
  website      String?            @db.VarChar(200)
  gstNumber    String?            @map("gst_number") @db.VarChar(32)
  panNumber    String?            @map("pan_number") @db.VarChar(16)
  addressLine  String?            @map("address_line") @db.VarChar(255)
  city         String?            @db.VarChar(80)
  state        String?            @db.VarChar(80)
  postalCode   String?            @map("postal_code") @db.VarChar(16)
  country      String             @default("IN") @db.VarChar(2)
  currency     String             @default("INR") @db.VarChar(3)
  timezone     String             @default("Asia/Kolkata") @db.VarChar(64)
  logoFileId   String?            @map("logo_file_id") @db.Uuid
  status       OrganizationStatus @default(ACTIVE)
  settings     Json?              @db.JsonB
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?            @map("deleted_by") @db.Uuid

  branches         Branch[]
  users            User[]
  roles            Role[]
  permissionOverrides UserPermissionOverride[]
  leadSources      LeadSource[]
  leads            Lead[]
  metaLeadIntegrations MetaLeadIntegration[]
  clients          Client[]
  projects         Project[]
  eventTypes       EventType[]
  events           Event[]
  shoots           Shoot[]
  departments      Department[]
  designations     Designation[]
  freelancers      Freelancer[]
  freelancerPlans  FreelancerPlan[]
  freelancerApplications FreelancerApplication[]
  freelancerConnections FreelancerConnection[]
  tasks            Task[]
  deliveries       Delivery[]
  quotations       Quotation[]
  invoices         Invoice[]
  payments         Payment[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]
  incomes          Income[]
  freelancerPayouts FreelancerPayout[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  personalTodos    PersonalTodo[]
  personalNotes    PersonalNote[]
  personalSheets    PersonalSheet[]
  files            FileObject[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  settingsEntries  SystemSetting[]
  idempotencyKeys  IdempotencyKey[]

  // Settings workspace (additive — a back-relation declares no column here).
  organizationSetting  OrganizationSetting?
  moduleAccessRequests ModuleAccessRequest[]

  clientPortalUsers      ClientPortalUser[]
  galleries              Gallery[]
  gallerySections        GallerySection[]
  gallerySubFolders      GallerySubFolder[]
  galleryMedia           GalleryMedia[]
  galleryMediaSelections GalleryMediaSelection[]
  galleryShareLinks      GalleryShareLink[]
  clientPortalComments   ClientPortalComment[]
  clientPortalRequests   ClientPortalRequest[]

  @@index([status])
  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(160)
  code           String    @db.VarChar(32)
  phone          String?   @db.VarChar(32)
  email          String?   @db.VarChar(160)
  addressLine    String?   @map("address_line") @db.VarChar(255)
  city           String?   @db.VarChar(80)
  state          String?   @db.VarChar(80)
  postalCode     String?   @map("postal_code") @db.VarChar(16)
  isHeadOffice   Boolean   @default(false) @map("is_head_office")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  users      User[]
  projects   Project[]
  expenses   Expense[]
  attendances Attendance[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("branches")
}

// ===========================================================================
// IDENTITY, ROLES & PERMISSIONS
// ===========================================================================

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  branchId            String?    @map("branch_id") @db.Uuid
  employeeCode        String?    @map("employee_code") @db.VarChar(32)
  fullName            String     @map("full_name") @db.VarChar(160)
  email               String     @db.VarChar(160)
  phone               String?    @db.VarChar(32)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  status              UserStatus @default(ACTIVE)
  avatarFileId        String?    @map("avatar_file_id") @db.Uuid
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?    @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employeeProfile EmployeeProfile?
  freelancerProfile Freelancer?

  userRoles          UserRole[]     @relation("UserRoleMember")
  personalRoles      Role[]         @relation("PersonalRole")
  permissionOverride UserPermissionOverride?
  rolesAssignedByMe  UserRole[]     @relation("UserRoleAssignedBy")
  sessions           Session[]
  loginHistories     LoginHistory[]
  emailTokens        EmailToken[]
  apiKeys            ApiKey[]

  createdLeads     Lead[]         @relation("LeadCreatedBy")
  ownedLeads       Lead[]         @relation("LeadOwner")
  leadFollowUps    LeadFollowUp[] @relation("LeadFollowUpOwner")

  clientNotes          ClientNote[]           @relation("ClientNoteAuthor")
  clientCommunications ClientCommunication[]  @relation("ClientCommunicationActor")

  createdProjects      Project[]              @relation("ProjectCreatedBy")
  managedProjects      Project[]              @relation("ProjectManager")
  projectStatusChanges ProjectStatusHistory[] @relation("ProjectStatusChangedBy")

  createdShoots        Shoot[]           @relation("ShootCreatedBy")
  shootAssignments     ShootAssignment[] @relation("ShootAssignmentUser")
  shootAssignmentsMade ShootAssignment[] @relation("ShootAssignmentAssignedBy")

  createdTasks        Task[]               @relation("TaskCreatedBy")
  assignedTasks       Task[]               @relation("TaskAssignee")
  taskAssignmentsTo   TaskAssignment[]     @relation("TaskAssignmentToUser")
  taskAssignmentsFrom TaskAssignment[]     @relation("TaskAssignmentFromUser")
  taskAssignmentsMade TaskAssignment[]     @relation("TaskAssignmentBy")
  taskStatusChanges   TaskStatusHistory[]  @relation("TaskStatusChangedBy")
  workSessions        WorkSession[]

  assignedDeliveries    Delivery[]               @relation("DeliveryAssignee")
  deliveryStatusChanges DeliveryStatusHistory[]  @relation("DeliveryStatusChangedBy")

  createdQuotations Quotation[] @relation("QuotationCreatedBy")
  createdInvoices   Invoice[]   @relation("InvoiceCreatedBy")
  receivedPayments  Payment[]   @relation("PaymentReceivedBy")
  createdExpenses   Expense[]   @relation("ExpenseCreatedBy")
  createdIncomes    Income[]    @relation("IncomeCreatedBy")
  approvedExpenses  Expense[]   @relation("ExpenseApprovedBy")
  freelancerPayouts FreelancerPayout[] @relation("FreelancerPayoutPaidBy")
  reviewedFreelancerApplications FreelancerApplication[] @relation("FreelancerApplicationReviewedBy")
  createdFreelancerOnboardingTokens FreelancerOnboardingToken[] @relation("FreelancerOnboardingTokenCreatedBy")
  createdFreelancerConnections   FreelancerConnection[]  @relation("FreelancerConnectionCreatedBy")

  attendances       Attendance[]   @relation("AttendanceUser")
  attendancesMarked Attendance[]   @relation("AttendanceMarkedBy")
  personalTodos     PersonalTodo[]
  personalNotes     PersonalNote[]
  personalSheets    PersonalSheet[]
  leaveRequests     LeaveRequest[] @relation("LeaveRequestUser")
  leaveReviews      LeaveRequest[] @relation("LeaveRequestReviewer")

  uploadedFiles FileObject[]   @relation("FileUploadedBy")
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  // Settings workspace (additive — a back-relation declares no column here).
  userSetting          UserSetting?
  moduleAccessRequests ModuleAccessRequest[] @relation("ModuleAccessRequester")
  moduleAccessReviews  ModuleAccessRequest[] @relation("ModuleAccessReviewer")

  galleryShareLinksCreated GalleryShareLink[]    @relation("GalleryShareCreatedBy")
  portalCommentsAuthored   ClientPortalComment[] @relation("PortalCommentAuthor")
  portalCommentsResolved   ClientPortalComment[] @relation("PortalCommentResolver")
  portalRequestsAssigned   ClientPortalRequest[] @relation("PortalRequestAssignee")

  @@unique([organizationId, email])
  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([branchId])
  @@index([email])
  @@map("users")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(64)
  description    String?   @db.VarChar(255)
  type           RoleType   @default(CUSTOM)
  status         RoleStatus @default(ACTIVE)
  isDefault      Boolean    @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid

  /// Set when the role exists to give one specific employee their own permission
  /// set. Such a role is never offered for anyone else to be assigned.
  personalForUserId String? @map("personal_for_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personalFor  User?        @relation("PersonalRole", fields: [personalForUserId], references: [id], onDelete: SetNull)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId, type])
  @@index([personalForUserId])
  @@map("roles")
}

/// An employee-specific effective permission set. The employee's fixed role is
/// unchanged; this row only overrides the permissions they receive from it.
model UserPermissionOverride {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  permissionKeys Json     @default("[]") @map("permission_keys") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("user_permission_overrides")
}

/// Global permission catalogue. Permissions are defined independently of roles
/// so that a role is only ever a named bundle of permission keys.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(80)
  module      String   @db.VarChar(48)
  label       String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  isSensitive Boolean  @default(false) @map("is_sensitive")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User  @relation("UserRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(128)
  status           SessionStatus @default(ACTIVE)
  ipAddress        String?       @map("ip_address") @db.Inet
  userAgent        String?       @map("user_agent") @db.VarChar(512)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastUsedAt       DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokeReason     LogoutReason? @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginHistory {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  email     String       @db.VarChar(160)
  outcome   LoginOutcome
  ipAddress String?      @map("ip_address") @db.Inet
  userAgent String?      @map("user_agent") @db.VarChar(512)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_history")
}

// ===========================================================================
// EMPLOYEE PROFILE (studio staff — distinct from Freelancer)
// ===========================================================================

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(80)
  description    String?   @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeProfiles EmployeeProfile[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Designation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String    @db.VarChar(80)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeProfiles EmployeeProfile[]

  @@unique([organizationId, title])
  @@map("designations")
}

model EmployeeProfile {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @unique @map("user_id") @db.Uuid
  departmentId     String?         @map("department_id") @db.Uuid
  designationId    String?         @map("designation_id") @db.Uuid
  employmentType   EmploymentType  @default(FULL_TIME) @map("employment_type")
  joiningDate      DateTime?       @map("joining_date") @db.Date
  exitDate         DateTime?       @map("exit_date") @db.Date
  dateOfBirth      DateTime?       @map("date_of_birth") @db.Date
  monthlySalary    Decimal?        @map("monthly_salary") @db.Decimal(14, 2)
  dailyRate        Decimal?        @map("daily_rate") @db.Decimal(14, 2)
  workLocation     WorkLocation    @default(OFFICE) @map("work_location")
  shiftStart       String?         @map("shift_start") @db.VarChar(8)
  shiftEnd         String?         @map("shift_end") @db.VarChar(8)
  weeklyOffDay     Int?            @map("weekly_off_day")
  attendanceRequired Boolean       @default(true) @map("attendance_required")
  reportingManagerId String?       @map("reporting_manager_id") @db.Uuid
  skills           String[]        @default([])
  emergencyContact String?         @map("emergency_contact") @db.VarChar(120)
  addressLine      String?         @map("address_line") @db.VarChar(255)
  city             String?         @db.VarChar(80)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([reportingManagerId])
  @@map("employee_profiles")
}

model StaffSalaryPayment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  paymentMonth   String   @map("payment_month") @db.VarChar(7)
  baseSalary     Decimal  @map("base_salary") @db.Decimal(14, 2)
  paidAmount     Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  notes          String?  @db.Text
  installments   Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([organizationId, userId, paymentMonth])
  @@index([organizationId, paymentMonth])
  @@map("staff_salary_payments")
}

// ===========================================================================
// CRM — Lead > Qualified > Client > Project
// ===========================================================================

model LeadSource {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(80)
  description    String?  @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leads Lead[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("lead_sources")
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  sourceId       String?    @map("source_id") @db.Uuid
  clientId       String?    @map("client_id") @db.Uuid
  name           String     @db.VarChar(160)
  phone          String     @db.VarChar(32)
  email          String?    @db.VarChar(160)
  eventType      ProjectType? @map("event_type")
  eventDate      DateTime?  @map("event_date") @db.Date
  venueCity      String?    @map("venue_city") @db.VarChar(80)
  status         LeadStatus @default(NEW)
  estimatedValue Decimal    @default(0) @map("estimated_value") @db.Decimal(14, 2)
  ownerId        String?    @map("owner_id") @db.Uuid
  nextFollowUpAt DateTime?  @map("next_follow_up_at") @db.Timestamptz(6)
  lostReason     String?    @map("lost_reason") @db.VarChar(255)
  convertedAt    DateTime?  @map("converted_at") @db.Timestamptz(6)
  notes          String?    @db.Text
  externalProvider String?  @map("external_provider") @db.VarChar(40)
  externalId     String?    @map("external_id") @db.VarChar(120)
  externalFormId String?    @map("external_form_id") @db.VarChar(120)
  externalAdId   String?    @map("external_ad_id") @db.VarChar(120)
  rawPayload     Json?      @map("raw_payload") @db.JsonB
  customFields   Json?      @map("custom_fields") @db.JsonB
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?    @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner        User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  followUps LeadFollowUp[]
  projects  Project[]

  @@index([organizationId, status])
  @@index([organizationId, nextFollowUpAt])
  @@index([ownerId, status])
  @@index([sourceId])
  @@index([phone])
  @@index([organizationId, externalProvider])
  @@unique([organizationId, externalProvider, externalId])
  @@map("leads")
}

model MetaLeadIntegration {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pageId         String    @map("page_id") @db.VarChar(120)
  pageName       String?   @map("page_name") @db.VarChar(160)
  isActive       Boolean   @default(true) @map("is_active")
  webhookVerifiedAt DateTime? @map("webhook_verified_at") @db.Timestamptz(6)
  lastWebhookAt  DateTime? @map("last_webhook_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.Text
  settings       Json?     @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([pageId])
  @@index([organizationId, isActive])
  @@map("meta_lead_integrations")
}

model LeadFollowUp {
  id          String              @id @default(uuid()) @db.Uuid
  leadId      String              @map("lead_id") @db.Uuid
  ownerId     String?             @map("owner_id") @db.Uuid
  channel     ContactChannel      @default(CALL)
  scheduledAt DateTime            @map("scheduled_at") @db.Timestamptz(6)
  completedAt DateTime?           @map("completed_at") @db.Timestamptz(6)
  outcome     LeadFollowUpOutcome @default(PENDING)
  summary     String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner User? @relation("LeadFollowUpOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([leadId, scheduledAt])
  @@index([ownerId, outcome])
  @@map("lead_follow_ups")
}

model Client {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  clientCode     String    @map("client_code") @db.VarChar(32)
  displayName    String    @map("display_name") @db.VarChar(160)
  primaryPhone   String    @map("primary_phone") @db.VarChar(32)
  primaryEmail   String?   @map("primary_email") @db.VarChar(160)
  brideName      String?   @map("bride_name") @db.VarChar(120)
  groomName      String?   @map("groom_name") @db.VarChar(120)
  gstNumber      String?   @map("gst_number") @db.VarChar(32)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contacts       ClientContact[]
  addresses      ClientAddress[]
  notes          ClientNote[]
  communications ClientCommunication[]
  leads          Lead[]
  projects       Project[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  deliveries     Delivery[]
  tasks          Task[]

  portalUsers    ClientPortalUser[]

  @@unique([organizationId, clientCode])
  @@index([organizationId, isActive])
  @@index([organizationId, displayName])
  @@index([primaryPhone])
  @@map("clients")
}

model ClientContact {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  name         String   @db.VarChar(120)
  relationship String?  @db.VarChar(60)
  phone        String?  @db.VarChar(32)
  email        String?  @db.VarChar(160)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model ClientAddress {
  id          String      @id @default(uuid()) @db.Uuid
  clientId    String      @map("client_id") @db.Uuid
  type        AddressType @default(HOME)
  label       String?     @db.VarChar(80)
  addressLine String      @map("address_line") @db.VarChar(255)
  city        String?     @db.VarChar(80)
  state       String?     @db.VarChar(80)
  postalCode  String?     @map("postal_code") @db.VarChar(16)
  country     String      @default("IN") @db.VarChar(2)
  isPrimary   Boolean     @default(false) @map("is_primary")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_addresses")
}

model ClientNote {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  authorId  String?   @map("author_id") @db.Uuid
  body      String    @db.Text
  isPinned  Boolean   @default(false) @map("is_pinned")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation("ClientNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("client_notes")
}

model ClientCommunication {
  id          String         @id @default(uuid()) @db.Uuid
  clientId    String         @map("client_id") @db.Uuid
  projectId   String?        @map("project_id") @db.Uuid
  actorId     String?        @map("actor_id") @db.Uuid
  channel     ContactChannel @default(CALL)
  subject     String?        @db.VarChar(200)
  body        String?        @db.Text
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor   User?    @relation("ClientCommunicationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, occurredAt])
  @@index([projectId])
  @@map("client_communications")
}

// ===========================================================================
// PROJECTS — the central entity
// ===========================================================================

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  branchId        String?       @map("branch_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  leadId          String?       @map("lead_id") @db.Uuid
  projectNumber   String        @map("project_number") @db.VarChar(32)
  name            String        @db.VarChar(200)
  type            ProjectType   @default(WEDDING)
  status          ProjectStatus @default(UPCOMING)
  isUrgent        Boolean       @default(false) @map("is_urgent")
  weddingDate     DateTime?     @map("wedding_date") @db.Date
  deliveryDueDate DateTime?     @map("delivery_due_date") @db.Date
  venueName       String?       @map("venue_name") @db.VarChar(200)
  venueAddress    String?       @map("venue_address") @db.VarChar(255)
  venueCity       String?       @map("venue_city") @db.VarChar(80)
  totalQuotation  Decimal       @default(0) @map("total_quotation") @db.Decimal(14, 2)
  totalStorageCapacityGb Decimal @default(5000.00) @map("total_storage_capacity_gb") @db.Decimal(14, 2)
  customServiceType String?     @map("custom_service_type") @db.VarChar(160)
  otherClientDetails String?    @map("other_client_details") @db.Text
  notes           String?       @db.Text
  createdById     String?       @map("created_by_id") @db.Uuid
  managerId       String?       @map("manager_id") @db.Uuid
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?       @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  manager      User?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  statusHistory  ProjectStatusHistory[]
  events         Event[]
  shoots         Shoot[]
  tasks          Task[]
  deliveries     Delivery[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  expenses       Expense[]
  incomes        Income[]
  files          FileObject[]
  communications ClientCommunication[]
  attendances    Attendance[]
  paymentMilestones PaymentMilestone[]
  freelancerConnections FreelancerConnection[]

  gallery               Gallery?
  clientPortalRequests  ClientPortalRequest[]
  clientPortalNotifications ClientPortalNotification[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId, status])
  @@index([organizationId, weddingDate])
  @@index([organizationId, status, deliveryDueDate])
  @@index([clientId])
  @@index([managerId])
  @@index([createdAt])
  @@map("projects")
}

model PaymentMilestone {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  title          String   @db.VarChar(160)
  dueDate        DateTime? @map("due_date") @db.Date
  amount         Decimal  @default(0) @db.Decimal(14, 2)
  status         String   @default("PENDING") @db.VarChar(20)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@map("payment_milestones")
}

model ProjectStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  oldStatus   ProjectStatus? @map("old_status")
  newStatus   ProjectStatus  @map("new_status")
  changedById String?        @map("changed_by_id") @db.Uuid
  reason      String?        @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("ProjectStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("project_status_history")
}

// ===========================================================================
// WEDDING EVENTS — one project has many functions (relational, never JSON)
// ===========================================================================

model EventType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(80)
  colorHex       String?  @map("color_hex") @db.VarChar(9)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  events Event[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("event_types")
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  eventTypeId    String?     @map("event_type_id") @db.Uuid
  name           String      @db.VarChar(160)
  eventDate      DateTime    @map("event_date") @db.Date
  startTime      DateTime?   @map("start_time") @db.Timestamptz(6)
  endTime        DateTime?   @map("end_time") @db.Timestamptz(6)
  venueName      String?     @map("venue_name") @db.VarChar(200)
  address        String?     @db.VarChar(255)
  city           String?     @db.VarChar(80)
  latitude       Decimal?    @db.Decimal(9, 6)
  longitude      Decimal?    @db.Decimal(9, 6)
  guestCount     Int?        @map("guest_count")
  status         EventStatus @default(PLANNED)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?     @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType    EventType?   @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)

  shoots     Shoot[]
  tasks      Task[]
  deliveries Delivery[]

  gallerySections GallerySection[]

  @@index([projectId, eventDate])
  @@index([organizationId, eventDate])
  @@index([status])
  @@map("events")
}

// ===========================================================================
// SHOOTS & CREW ASSIGNMENT
// ===========================================================================

model Shoot {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  eventId        String?     @map("event_id") @db.Uuid
  title          String      @db.VarChar(160)
  shootType      ShootType   @default(PHOTO_AND_VIDEO) @map("shoot_type")
  shootDate      DateTime    @map("shoot_date") @db.Date
  startTime      DateTime?   @map("start_time") @db.Timestamptz(6)
  endTime        DateTime?   @map("end_time") @db.Timestamptz(6)
  location       String?     @db.VarChar(255)
  city           String?     @db.VarChar(80)
  status         ShootStatus @default(SCHEDULED)
  notes          String?     @db.Text
  plannedRoleSlots Json?     @map("planned_role_slots")
  dataSizeGb     Decimal?    @map("data_size_gb") @db.Decimal(10, 2)
  dataReceivedAt DateTime?   @map("data_received_at") @db.Timestamptz(6)
  backupDoneAt   DateTime?   @map("backup_done_at") @db.Timestamptz(6)
  createdById    String?     @map("created_by_id") @db.Uuid
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?     @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ShootCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments ShootAssignment[]
  tasks       Task[]
  expenses    Expense[]
  freelancerConnections FreelancerConnection[]

  @@index([projectId])
  @@index([eventId])
  @@index([shootDate])
  @@index([status])
  @@index([organizationId, shootDate])
  @@index([organizationId, status, shootDate])
  @@map("shoots")
}

/// Crew assignment for a shoot. Exactly one of `userId` (studio employee) or
/// `freelancerId` (external crew) is set — enforced by a CHECK constraint
/// (`num_nonnulls(user_id, freelancer_id) = 1`) in the migration SQL.
/// Duplicate assignment of the same person to the same shoot role is blocked by
/// the two unique indexes below. The same person may hold different roles on
/// the same shoot. Same-day work on another project is rejected in the service layer.
model ShootAssignment {
  id               String           @id @default(uuid()) @db.Uuid
  shootId          String           @map("shoot_id") @db.Uuid
  userId           String?          @map("user_id") @db.Uuid
  freelancerId     String?          @map("freelancer_id") @db.Uuid
  role             CrewRole         @default(LEAD_PHOTOGRAPHER)
  status           AssignmentStatus @default(ASSIGNED)
  agreedAmount     Decimal          @default(0) @map("agreed_amount") @db.Decimal(14, 2)
  travelAmount     Decimal          @default(0) @map("travel_amount") @db.Decimal(14, 2)
  extraAmount      Decimal          @default(0) @map("extra_amount") @db.Decimal(14, 2)
  callTime         DateTime?        @map("call_time") @db.Timestamptz(6)
  checkInAt        DateTime?        @map("check_in_at") @db.Timestamptz(6)
  checkOutAt       DateTime?        @map("check_out_at") @db.Timestamptz(6)
  dataSizeGb       Decimal?         @map("data_size_gb") @db.Decimal(10, 2)
  dataReceived     Boolean          @default(false) @map("data_received")
  storageReference String?          @map("storage_reference") @db.VarChar(160)
  notes            String?          @db.Text
  assignedById     String?          @map("assigned_by_id") @db.Uuid
  assignedAt       DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  shoot      Shoot       @relation(fields: [shootId], references: [id], onDelete: Cascade)
  user       User?       @relation("ShootAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  freelancer Freelancer? @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  assignedBy User?       @relation("ShootAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  payouts FreelancerPayout[]

  @@unique([shootId, userId, role])
  @@unique([shootId, freelancerId, role])
  @@index([shootId])
  @@index([userId, status])
  @@index([freelancerId, status])
  @@map("shoot_assignments")
}

// ===========================================================================
// FREELANCERS — external crew, kept strictly separate from employees (User)
// ===========================================================================

model Freelancer {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String?          @unique @map("user_id") @db.Uuid
  code           String           @db.VarChar(32)
  fullName       String           @map("full_name") @db.VarChar(160)
  phone          String           @db.VarChar(32)
  whatsapp       String?          @db.VarChar(32)
  email          String?          @db.VarChar(160)
  city           String?          @db.VarChar(80)
  addressLine    String?          @map("address_line") @db.VarChar(255)
  primarySkill   CrewRole         @default(LEAD_PHOTOGRAPHER) @map("primary_skill")
  skills         String[]         @default([])
  experienceYears Int?            @map("experience_years")
  rate           Decimal          @default(0) @db.Decimal(14, 2)
  rateType       RateType         @default(PER_DAY) @map("rate_type")
  travelAvailable Boolean         @default(true) @map("travel_available")
  maxShootsPerDay Int             @default(1) @map("max_shoots_per_day")
  rating          Decimal?        @db.Decimal(3, 2)
  status         FreelancerStatus @default(ACTIVE)
  equipmentNotes String?          @map("equipment_notes") @db.Text
  paymentMethod  PaymentMethod?   @map("payment_method")
  upiId          String?          @map("upi_id") @db.VarChar(120)
  bankName       String?          @map("bank_name") @db.VarChar(120)
  accountHolder  String?          @map("account_holder") @db.VarChar(160)
  accountNumber  String?          @map("account_number") @db.VarChar(64)
  ifsc           String?          @db.VarChar(16)
  panNumber      String?          @map("pan_number") @db.VarChar(16)
  gstNumber      String?          @map("gst_number") @db.VarChar(32)
  notes          String?          @db.Text
  passwordHash   String?          @map("password_hash") @db.VarChar(255)
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime?        @map("locked_until") @db.Timestamptz(6)
  lastLoginAt    DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?          @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  assignments ShootAssignment[]
  payouts     FreelancerPayout[]
  expenses    Expense[]
  subscriptions FreelancerSubscription[]
  availability  FreelancerAvailability[]
  portfolioItems FreelancerPortfolioItem[]
  applications  FreelancerApplication[]
  connections   FreelancerConnection[]
  sessions      FreelancerSession[]
  onboardingTokens FreelancerOnboardingToken[]

  @@unique([organizationId, code])
  @@index([userId])
  @@index([organizationId, status])
  @@index([organizationId, primarySkill])
  @@index([phone])
  @@map("freelancers")
}

model FreelancerSession {
  id               String        @id @default(uuid()) @db.Uuid
  freelancerId     String        @map("freelancer_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(64)
  status           SessionStatus @default(ACTIVE)
  ipAddress        String?       @map("ip_address") @db.Inet
  userAgent        String?       @map("user_agent") @db.VarChar(512)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastUsedAt       DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokeReason     LogoutReason? @map("revoke_reason")

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId, status])
  @@index([expiresAt])
  @@map("freelancer_sessions")
}

model FreelancerPlan {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  name            String          @db.VarChar(120)
  slug            String          @db.VarChar(120)
  description     String?         @db.Text
  price           Decimal         @default(0) @db.Decimal(14, 2)
  currency        String          @default("INR") @db.VarChar(3)
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  features        Json?           @db.JsonB
  limits          Json?           @db.JsonB
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscriptions FreelancerSubscription[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("freelancer_plans")
}

model FreelancerSubscription {
  id                     String                       @id @default(uuid()) @db.Uuid
  freelancerId           String                       @map("freelancer_id") @db.Uuid
  planId                 String                       @map("plan_id") @db.Uuid
  status                 FreelancerSubscriptionStatus @default(PENDING)
  startedAt              DateTime?                    @map("started_at") @db.Timestamptz(6)
  currentPeriodStart     DateTime?                    @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?                    @map("current_period_end") @db.Timestamptz(6)
  canceledAt             DateTime?                    @map("canceled_at") @db.Timestamptz(6)
  externalCustomerId     String?                      @map("external_customer_id") @db.VarChar(160)
  externalSubscriptionId String?                      @map("external_subscription_id") @db.VarChar(160)
  metadata               Json?                        @db.JsonB
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  freelancer Freelancer     @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  plan       FreelancerPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([freelancerId, status])
  @@index([planId, status])
  @@index([status, currentPeriodEnd])
  @@map("freelancer_subscriptions")
}

model FreelancerAvailability {
  id           String                       @id @default(uuid()) @db.Uuid
  freelancerId String                       @map("freelancer_id") @db.Uuid
  date         DateTime                     @db.Date
  status       FreelancerAvailabilityStatus @default(AVAILABLE)
  startTime    DateTime?                    @map("start_time") @db.Timestamptz(6)
  endTime      DateTime?                    @map("end_time") @db.Timestamptz(6)
  notes        String?                      @db.Text
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, date])
  @@index([date, status])
  @@index([freelancerId, status])
  @@map("freelancer_availability")
}

model FreelancerPortfolioItem {
  id           String   @id @default(uuid()) @db.Uuid
  freelancerId String   @map("freelancer_id") @db.Uuid
  fileObjectId String   @map("file_object_id") @db.Uuid
  title        String   @db.VarChar(160)
  description  String?  @db.Text
  category     String?  @db.VarChar(80)
  sortOrder    Int      @default(0) @map("sort_order")
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  fileObject FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)

  @@index([freelancerId, isPublished, sortOrder])
  @@index([fileObjectId])
  @@map("freelancer_portfolio_items")
}

model FreelancerApplication {
  id              String                      @id @default(uuid()) @db.Uuid
  organizationId  String                      @map("organization_id") @db.Uuid
  freelancerId    String?                     @map("freelancer_id") @db.Uuid
  fullName        String                      @map("full_name") @db.VarChar(160)
  phone           String                      @db.VarChar(32)
  whatsapp        String?                     @db.VarChar(32)
  email           String?                     @db.VarChar(160)
  city            String?                     @db.VarChar(80)
  primarySkill    CrewRole                    @default(LEAD_PHOTOGRAPHER) @map("primary_skill")
  skills          String[]                    @default([])
  experienceYears Int?                        @map("experience_years")
  portfolioUrl    String?                     @map("portfolio_url") @db.VarChar(1024)
  expectedRate    Decimal?                    @map("expected_rate") @db.Decimal(14, 2)
  rateType        RateType                    @default(PER_DAY) @map("rate_type")
  status          FreelancerApplicationStatus @default(SUBMITTED)
  submittedAt     DateTime?                   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt      DateTime?                   @map("reviewed_at") @db.Timestamptz(6)
  reviewedById    String?                     @map("reviewed_by_id") @db.Uuid
  rejectionReason String?                     @map("rejection_reason") @db.VarChar(500)
  notes           String?                     @db.Text
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  freelancer   Freelancer?  @relation(fields: [freelancerId], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("FreelancerApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  onboardingTokens FreelancerOnboardingToken[]

  @@index([organizationId, status, submittedAt])
  @@index([organizationId, primarySkill])
  @@index([phone])
  @@index([freelancerId])
  @@map("freelancer_applications")
}

model FreelancerOnboardingToken {
  id              String    @id @default(uuid()) @db.Uuid
  freelancerId    String    @map("freelancer_id") @db.Uuid
  applicationId   String?   @map("application_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  invalidatedAt   DateTime? @map("invalidated_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  freelancer  Freelancer             @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  application FreelancerApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdBy   User?                  @relation("FreelancerOnboardingTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([freelancerId, usedAt, invalidatedAt, expiresAt])
  @@index([applicationId])
  @@index([createdById])
  @@map("freelancer_onboarding_tokens")
}

model FreelancerConnection {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  freelancerId   String                     @map("freelancer_id") @db.Uuid
  projectId      String?                    @map("project_id") @db.Uuid
  shootId        String?                    @map("shoot_id") @db.Uuid
  createdById    String?                    @map("created_by_id") @db.Uuid
  status         FreelancerConnectionStatus @default(INTERESTED)
  notes          String?                    @db.Text
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  freelancer   Freelancer   @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shoot        Shoot?       @relation(fields: [shootId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("FreelancerConnectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([freelancerId, status])
  @@index([projectId, status])
  @@index([shootId, status])
  @@map("freelancer_connections")
}

/// A freelancer settlement. Every payout writes one matching Expense row in the
/// same transaction (1:1 via `expenseId`), so `expenses` stays the single cost
/// ledger and profitability never double-counts crew cost.
model FreelancerPayout {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  freelancerId   String        @map("freelancer_id") @db.Uuid
  assignmentId   String?       @map("assignment_id") @db.Uuid
  expenseId      String        @unique @map("expense_id") @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  paymentDate    DateTime      @map("payment_date") @db.Date
  paymentMethod  PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  transactionRef String?       @map("transaction_ref") @db.VarChar(120)
  notes          String?       @db.Text
  paidById       String?       @map("paid_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  freelancer   Freelancer       @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  assignment   ShootAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  expense      Expense          @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  paidBy       User?            @relation("FreelancerPayoutPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([freelancerId, paymentDate])
  @@index([assignmentId])
  @@map("freelancer_payouts")
}

// ===========================================================================
// TASKS
// ===========================================================================

model Task {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  projectId        String?      @map("project_id") @db.Uuid
  eventId          String?      @map("event_id") @db.Uuid
  shootId          String?      @map("shoot_id") @db.Uuid
  deliveryId       String?      @map("delivery_id") @db.Uuid
  clientId         String?      @map("client_id") @db.Uuid
  title            String       @db.VarChar(200)
  description      String?      @db.Text
  category         TaskCategory @default(OTHER)
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  quantity         Int          @default(1)
  unit             String?      @db.VarChar(160)
  dueDate          DateTime?    @map("due_date") @db.Date
  assigneeId       String?      @map("assignee_id") @db.Uuid
  createdById      String?      @map("created_by_id") @db.Uuid
  estimatedMinutes Int          @default(0) @map("estimated_minutes")
  actualMinutes    Int          @default(0) @map("actual_minutes")
  startedAt        DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy        String?      @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  shoot        Shoot?       @relation(fields: [shootId], references: [id], onDelete: SetNull)
  delivery     Delivery?    @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments   TaskAssignment[]
  statusHistory TaskStatusHistory[]
  workSessions  WorkSession[]

  @@index([assigneeId, status])
  @@index([status])
  @@index([dueDate])
  @@index([projectId])
  @@index([organizationId, status])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, assigneeId, status])
  @@map("tasks")
}

/// Private checklist that belongs only to the signed-in employee.
/// Never listed across users — every query is scoped to `userId`.
model PersonalTodo {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  title          String       @db.VarChar(200)
  category       String?      @db.VarChar(80)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @map("due_date") @db.Date
  completed      Boolean      @default(false)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@index([organizationId, userId])
  @@index([organizationId, userId, completed])
  @@map("personal_todos")
}

/// Private notepad that belongs only to the signed-in employee.
model PersonalNote {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String    @db.VarChar(200)
  content        String    @db.Text
  pinned         Boolean   @default(false)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@index([organizationId, userId])
  @@map("personal_notes")
}

/// A private scratch spreadsheet, one per user. The grid is free-form and only
/// ever read back by its owner, so the cells live in a single JSONB document
/// rather than as relational rows.
model PersonalSheet {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  data           Json     @default("{\"columns\":[],\"rows\":[]}") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("personal_sheets")
}

/// Full reassignment trail — every change of task ownership is auditable.
model TaskAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  fromUserId   String?  @map("from_user_id") @db.Uuid
  toUserId     String?  @map("to_user_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  reason       String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUser   User? @relation("TaskAssignmentFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser     User? @relation("TaskAssignmentToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  assignedBy User? @relation("TaskAssignmentBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([toUserId])
  @@map("task_assignments")
}

model TaskStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  taskId      String      @map("task_id") @db.Uuid
  oldStatus   TaskStatus? @map("old_status")
  newStatus   TaskStatus  @map("new_status")
  changedById String?     @map("changed_by_id") @db.Uuid
  reason      String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User? @relation("TaskStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
