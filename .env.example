# ---------------------------------------------------------------------------
# Frameloom — Backend environment template
# Copy to .env and replace every placeholder. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV="development"
# NOTE on macOS: Control Center's AirPlay Receiver listens on 5000. Either turn
# it off (System Settings > General > AirDrop & Handoff) or use another port.
PORT="5000"
API_BASE_PATH="/api/v1"

# --- PostgreSQL ------------------------------------------------------------
# The ONLY supported database engine. MySQL is not supported.
DATABASE_URL="postgresql://postgres:password@localhost:5432/wedding_photo_planet?schema=public"

# Separate database used by `npm test`. It is migrated and truncated by the
# test harness, so it must NEVER point at a database holding real data.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/wedding_photo_planet_test?schema=public"

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="replace_me"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace_me"
REFRESH_TOKEN_EXPIRES_IN="7d"
FREELANCER_ONBOARDING_TOKEN_EXPIRES_IN="48h"
# Set to true when the API is served over HTTPS (forces Secure cookies).
COOKIE_SECURE="false"
COOKIE_DOMAIN=""

# --- CORS ------------------------------------------------------------------
# Strict allowlist. Comma-separated. No wildcards are honoured.
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="300"
AUTH_RATE_LIMIT_MAX="10"

# --- Request limits --------------------------------------------------------
JSON_BODY_LIMIT="1mb"
MAX_PAGE_SIZE="100"
DEFAULT_PAGE_SIZE="25"

# --- Logging ---------------------------------------------------------------
LOG_LEVEL="info"

# --- File storage ----------------------------------------------------------
# One of: LOCAL | DATABASE | S3 | R2 | SUPABASE
#
#   LOCAL     development only. Writes to ./.local-storage and does not survive
#             a serverless deploy. Rejected in production.
#   DATABASE  stores bytes in the PostgreSQL `files.content` column. Persistent
#             and needs no extra account, but every photograph counts against
#             database storage and lands in every backup and branch, so it does
#             not suit wedding galleries at volume.
#   R2/S3/    real object storage, presigned by the backend. The right home for
#   SUPABASE  galleries: cheap at scale and served without touching this API.
#             Cloudflare R2 is recommended — it charges no egress, which is what
#             a couple downloading a 40GB gallery would otherwise cost.
STORAGE_PROVIDER="LOCAL"
STORAGE_BUCKET="frameloom"

# R2: "auto". S3: the bucket's region, e.g. ap-south-1.
STORAGE_REGION="auto"
# R2: https://<account-id>.r2.cloudflarestorage.com
# S3: https://s3.<region>.amazonaws.com
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Only used by LOCAL and DATABASE, which serve bytes from this backend.
STORAGE_PUBLIC_BASE_URL=""
SIGNED_URL_TTL_SECONDS="900"

# --- Meta Lead Ads ---------------------------------------------------------
# Webhook URL: https://your-api-domain.com/api/v1/integrations/meta/webhook
# Do not commit real app secrets or page tokens.
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_API_VERSION="v26.0"

# --- Seed (development bootstrap only) -------------------------------------
# White-label identity: change these to resell under another name.
BRAND_NAME="Frameloom"
BRAND_COOKIE_PREFIX="fl"
BRAND_SUPPORT_EMAIL="support@example.com"

SEED_ORG_NAME="Demo Studio"
SEED_ORG_SLUG="demo-studio"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace_me"
# Set to true ONLY on a development machine to load sample CRM records.
SEED_DEMO_DATA="false"
