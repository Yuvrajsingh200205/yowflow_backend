{
  "buildCommand": "npx prisma generate",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{node_modules/.prisma/client/**,assets/fonts/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cron/reminders",
      "schedule": "30 3 * * *"
    }
  ]
}
